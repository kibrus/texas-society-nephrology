# =============================================================================
# TSN membership / payment environment variables
# -----------------------------------------------------------------------------
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Names and comments only live here — no real secret values.
#
# Validation: lib/env/public.ts (browser-safe) and lib/env/server.ts
# (server-only) fail fast at startup if a required value is missing/invalid.
#
# PRODUCTION MIGRATION NOTES are marked with [PROD] below.
# =============================================================================

# ---- App ----
# Public base URL of the deployment.
#   Local:   http://localhost:3000
#   Staging: https://texas-society-nephrology.vercel.app
#   [PROD]   https://www.txsocietyofnephrology.org
NEXT_PUBLIC_SITE_URL=

# ---- Supabase ----
# Project URL and PUBLISHABLE (browser-safe) key. Safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET key (service-role equivalent). SERVER ONLY. Bypasses RLS.
# Never prefix with NEXT_PUBLIC_. Never log or return to the browser.
# [PROD] Use the production Supabase project's secret key.
SUPABASE_SECRET_KEY=

# ---- Stripe ----
# Publishable key is browser-safe. Secret + webhook secret are SERVER ONLY.
#   [PROD] Swap all Stripe keys to LIVE mode and set the LIVE price IDs.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook signing secret. Environment-specific — do NOT reuse across envs.
#   [PROD] Create a separate production webhook at
#          https://www.txsocietyofnephrology.org/api/stripe/webhook and use ITS secret.
STRIPE_WEBHOOK_SECRET=
# Recurring annual Price IDs. Server maps membership tier -> price ID.
#   Test mode: Trainee $25/yr, Full $75/yr already exist in the sandbox.
#   [PROD] Replace with LIVE-mode price IDs after verifying live products.
STRIPE_PRICE_TRAINEE=
STRIPE_PRICE_FULL=
# Pinned Stripe API version string (must be supported by the installed SDK).
STRIPE_API_VERSION=

# ---- Resend / transactional email ----
# API key is SERVER ONLY. Use the "TSN Staging Website" key here (NOT the
# Supabase Auth SMTP key). [PROD] Use a production-scoped sending key.
RESEND_API_KEY=
# Labeled sender. Domain must be verified in Resend (SPF/DKIM) before sending.
#   e.g. "Texas Society of Nephrology <noreply@txsocietyofnephrology.org>"
EMAIL_FROM=
# Reply-to for membership/payment mail.
EMAIL_REPLY_TO=support@txsocietyofnephrology.org
# Recipient of public Contact Us form submissions.
CONTACT_RECIPIENT_EMAIL=contact@txsocietyofnephrology.org

# ---- Operational (introduced in later stages; optional until then) ----
# Shared secret authenticating the internal cron/job worker endpoint.
# Becomes REQUIRED when the outbox/jobs worker stage lands.
CRON_SECRET=
# Private operational escalation recipient (e.g. kibru@txsocietyofnephrology.org).
ADMIN_ESCALATION_EMAIL=

# ---- Deferred: Google Drive invoice archival (do not enable without approval) ----
# GOOGLE_DRIVE_INVOICE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
